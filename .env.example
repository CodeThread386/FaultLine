NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-strong-secret

# Supabase (use one key name per role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demo login (numeric). Leave unset or "true" for rehearsal; set "false" for production OAuth build.
NEXT_PUBLIC_DEMO_LOGIN=true

# Optional: distributed rate limiting (recommended for ~500 concurrent users)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional override (default vitstudent.ac.in) — reserved for future OAuth
AUTH_ALLOWED_EMAIL_DOMAIN=vitstudent.ac.in
